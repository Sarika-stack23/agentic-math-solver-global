# ── AI Models ────────────────────────────────────────────────────────
# Primary: Groq (Free, Ultra-Fast Inference)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Optional: Google AI Studio (For Vision fallback)
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Database ─────────────────────────────────────────────────────────
# Firebase credentials for Firestore and Auth
USE_FIREBASE=true
# Set this to enable Local Development token verification without a service account JSON
FIREBASE_PROJECT_ID="global-math"
# Required for Firestore (saving/loading progress). Provide the path to your service account JSON
FIREBASE_CREDENTIALS_PATH="./backend/firebase-adminsdk.json"

# ── Backend Server ───────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8080
ENVIRONMENT="development"
LOG_LEVEL="INFO"
